  "examples": [
    {
      "clientId": "example-01",
      "objectiveIds": ["objective-01", "objective-02"],
      "problem": {
        "text": "判断 ABA 属于哪一类，并说明理由。",
        "evidenceRefs": [
          {
            "sourceId": "source-fictional-01",
            "sourceRevision": "e89119881271db83e57f91d6cff9ecf2a9867fa2265882c2c08d425f913a862b",
            "excerptId": "excerpt-01"
          }
        ]
      },
      "steps": [
        {
          "text": "指出第一和第三个字符，二者都是 A。",
          "evidenceRefs": [
            {
              "sourceId": "source-fictional-01",
              "sourceRevision": "e89119881271db83e57f91d6cff9ecf2a9867fa2265882c2c08d425f913a862b",
              "excerptId": "excerpt-01"
            }
          ]
        },
        {
          "text": "比较两个字符：它们相同，中间的 B 不参与分类。",
          "evidenceRefs": [
            {
              "sourceId": "source-fictional-01",
              "sourceRevision": "e89119881271db83e57f91d6cff9ecf2a9867fa2265882c2c08d425f913a862b",
              "excerptId": "excerpt-01"
            }
          ]
        }
      ],
      "result": {
        "text": "ABA 是回环卡，因为第一和第三个字符相同。",
        "evidenceRefs": [
          {
            "sourceId": "source-fictional-01",
            "sourceRevision": "e89119881271db83e57f91d6cff9ecf2a9867fa2265882c2c08d425f913a862b",
            "excerptId": "excerpt-01"
          }
        ]
      }
    }
  ],
  "assessments": [
    {
      "clientId": "assessment-01",
      "objectiveIds": ["objective-01", "objective-02"],
      "prompt": {
        "text": "分别判断 BAB 和 ABB 的类别，并为每个判断写出比较的两个字符，再说明中间字符为什么不影响分类。",
        "evidenceRefs": [
          {
            "sourceId": "source-fictional-01",
            "sourceRevision": "e89119881271db83e57f91d6cff9ecf2a9867fa2265882c2c08d425f913a862b",
            "excerptId": "excerpt-01"
          }
        ]
      },
      "evaluation": {
        "kind": "reference-answer",
        "teacherText": {
          "text": "BAB 是回环卡，比较的是 B 与 B。ABB 是断环卡，比较的是 A 与 B。规则只比较第一和第三个字符，因此中间字符不影响分类。",
          "evidenceRefs": [
            {
              "sourceId": "source-fictional-01",
              "sourceRevision": "e89119881271db83e57f91d6cff9ecf2a9867fa2265882c2c08d425f913a862b",
              "excerptId": "excerpt-01"
            }
          ]
        },
        "reasoningOrCriteria": [
          {
            "text": "两个类别都正确。",
            "evidenceRefs": [
              {
                "sourceId": "source-fictional-01",
                "sourceRevision": "e89119881271db83e57f91d6cff9ecf2a9867fa2265882c2c08d425f913a862b",
                "excerptId": "excerpt-01"
              }
            ]
          },
          {
            "text": "每个判断都明确比较第一和第三个字符，不以中间字符为依据。",
            "evidenceRefs": [
              {
                "sourceId": "source-fictional-01",
                "sourceRevision": "e89119881271db83e57f91d6cff9ecf2a9867fa2265882c2c08d425f913a862b",
                "excerptId": "excerpt-01"
              }
            ]
          }
        ]
      },
      "studentEvidenceExpected": "提交两项分类、两项字符比较说明，以及中间字符不影响分类的规则依据。"
    }
  ],
