{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coursemapper.local/schemas/quality-model-comparison-v1.json",
  "title": "CourseMapper controlled model comparison v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "comparisonId",
    "protocolVersion",
    "createdAt",
    "preregistration",
    "environment",
    "candidateId",
    "controlId",
    "models",
    "trials"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "comparisonId": { "type": "string", "minLength": 4 },
    "protocolVersion": { "const": "1.0.0" },
    "createdAt": { "type": "string", "format": "date-time" },
    "preregistration": {
      "type": "object",
      "required": [
        "frozenAt",
        "analysisPlanSha256",
        "corpusManifestSha256",
        "minimumTrialsPerCase",
        "caseIds",
        "stoppingRule",
        "exclusionPolicy"
      ],
      "additionalProperties": false,
      "properties": {
        "frozenAt": { "type": "string", "format": "date-time" },
        "analysisPlanSha256": { "$ref": "#/$defs/sha256" },
        "corpusManifestSha256": { "$ref": "#/$defs/sha256" },
        "minimumTrialsPerCase": { "type": "integer", "minimum": 3 },
        "primaryPreferenceEvidence": {
          "enum": ["qualified-human", "single-model-judge"],
          "default": "qualified-human"
        },
        "requiredQualifiedPreferencesPerTrial": { "type": "integer", "minimum": 2 },
        "modelJudge": { "$ref": "#/$defs/modelJudgeContract" },
        "caseIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3 }
        },
        "stoppingRule": { "type": "string", "minLength": 20 },
        "exclusionPolicy": { "type": "string", "minLength": 20 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "primaryPreferenceEvidence": { "const": "single-model-judge" } },
            "required": ["primaryPreferenceEvidence"]
          },
          "then": { "required": ["modelJudge"] },
          "else": { "required": ["requiredQualifiedPreferencesPerTrial"] }
        }
      ]
    },
    "candidateId": { "type": "string", "minLength": 2 },
    "controlId": { "type": "string", "minLength": 2 },
    "environment": {
      "type": "object",
      "required": ["compilerCommit", "dirtyTree"],
      "properties": {
        "compilerCommit": { "type": "string", "minLength": 7 },
        "dirtyTree": { "const": false },
        "runtime": { "type": "string" },
        "hardware": { "type": "string" }
      }
    },
    "models": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/model" } },
    "trials": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/trial" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "modelJudgeContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "modelRevision",
        "promptSha256",
        "evidenceProtocol",
        "requiredPassesPerTrial",
        "requiredOrders"
      ],
      "properties": {
        "model": { "type": "string", "minLength": 3 },
        "modelRevision": { "type": "string", "minLength": 3 },
        "promptSha256": { "$ref": "#/$defs/sha256" },
        "evidenceProtocol": { "const": "recomputable-two-order-v1" },
        "requiredPassesPerTrial": { "type": "integer", "minimum": 2 },
        "requiredOrders": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["A/B", "B/A"] }
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provider",
        "model",
        "revision",
        "promptSha256",
        "configurationSha256",
        "parameters",
        "compilerCommit",
        "graderVersion"
      ],
      "properties": {
        "id": { "type": "string" },
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "revision": { "type": "string" },
        "promptSha256": { "$ref": "#/$defs/sha256" },
        "configurationSha256": { "$ref": "#/$defs/sha256" },
        "parameters": { "type": "object" },
        "compilerCommit": { "type": "string" },
        "graderVersion": { "type": "string" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelId", "status", "latencyMs", "costUsd", "providerCalls", "retryCount", "compilerBurden"],
      "properties": {
        "modelId": { "type": "string" },
        "status": { "enum": ["success", "provider-failure", "validation-failure", "timeout", "cancelled"] },
        "outputSha256": { "type": "string" },
        "latencyMs": { "type": "number", "minimum": 0 },
        "costUsd": { "type": "number", "minimum": 0 },
        "providerCalls": { "type": "integer", "minimum": 0 },
        "retryCount": { "type": "integer", "minimum": 0 },
        "benchmarkScore": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "dimensionScores": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0, "maximum": 100 }
        },
        "compilerBurden": { "$ref": "#/$defs/compilerBurden" },
        "scoreEvidence": { "$ref": "#/$defs/scoreEvidence" }
      }
    },
    "compilerBurden": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scionCalls", "repairCalls", "rejectedAtoms", "recoveredAtoms"],
      "properties": {
        "scionCalls": { "type": "integer", "minimum": 0 },
        "repairCalls": { "type": "integer", "minimum": 0 },
        "rejectedAtoms": { "type": "integer", "minimum": 0 },
        "recoveredAtoms": { "type": "integer", "minimum": 0 }
      }
    },
    "scoreEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rubricVersion",
        "rubricSha256",
        "scorecardSha256",
        "scorecardPath",
        "evidenceClass",
        "validationTier",
        "sourceSha256",
        "artifactSha256"
      ],
      "properties": {
        "rubricVersion": { "const": "1.0.0" },
        "rubricSha256": { "$ref": "#/$defs/sha256" },
        "scorecardSha256": { "$ref": "#/$defs/sha256" },
        "scorecardPath": { "type": "string", "minLength": 3 },
        "evidenceClass": {
          "enum": ["deterministic", "model-judge", "human-other", "human-qualified"]
        },
        "validationTier": {
          "enum": [
            "automated-signal",
            "model-provisional",
            "human-reviewed",
            "human-reviewed-disputed",
            "independently-validated"
          ]
        },
        "sourceSha256": { "$ref": "#/$defs/sha256" },
        "artifactSha256": { "$ref": "#/$defs/sha256" },
        "aggregationBootstrapSamples": { "type": "integer", "minimum": 100 },
        "model": { "type": "string", "minLength": 3 },
        "modelRevision": { "type": "string", "minLength": 3 },
        "promptSha256": { "$ref": "#/$defs/sha256" },
        "reviewBundlePath": { "type": "string", "minLength": 3 },
        "reviewBundleSha256": { "$ref": "#/$defs/sha256" },
        "passScorecards": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/passScorecard" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "evidenceClass": { "const": "model-judge" } },
            "required": ["evidenceClass"]
          },
          "then": {
            "required": [
              "model",
              "modelRevision",
              "promptSha256",
              "aggregationBootstrapSamples",
              "reviewBundlePath",
              "reviewBundleSha256",
              "passScorecards"
            ]
          }
        }
      ]
    },
    "preference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewerId",
        "evidenceClass",
        "blinded",
        "preference",
        "rationale",
        "reviewedAt",
        "candidateArtifactSha256",
        "controlArtifactSha256"
      ],
      "properties": {
        "reviewerId": { "type": "string", "minLength": 3 },
        "evidenceClass": { "enum": ["model-judge", "human-other", "human-qualified"] },
        "qualified": { "type": "boolean" },
        "independent": { "type": "boolean" },
        "conflictOfInterest": { "type": "boolean" },
        "domainMatch": { "type": "boolean" },
        "currentTeachingRole": { "type": "string" },
        "model": { "type": "string", "minLength": 3 },
        "modelRevision": { "type": "string", "minLength": 3 },
        "promptSha256": { "$ref": "#/$defs/sha256" },
        "sessionId": { "type": "string", "minLength": 8 },
        "blinded": { "const": true },
        "preference": { "enum": ["A", "B", "tie"] },
        "order": { "enum": ["A/B", "B/A"] },
        "rationale": { "type": "string", "minLength": 20 },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "candidateArtifactSha256": { "$ref": "#/$defs/sha256" },
        "controlArtifactSha256": { "$ref": "#/$defs/sha256" },
        "candidateScorecardSha256": { "$ref": "#/$defs/sha256" },
        "controlScorecardSha256": { "$ref": "#/$defs/sha256" },
        "scoredBeforePreference": { "const": true },
        "decisionEvidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/decisionEvidence" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "evidenceClass": { "const": "model-judge" } },
            "required": ["evidenceClass"]
          },
          "then": {
            "required": [
              "model",
              "modelRevision",
              "promptSha256",
              "sessionId",
              "order",
              "candidateScorecardSha256",
              "controlScorecardSha256",
              "scoredBeforePreference",
              "decisionEvidence"
            ]
          }
        }
      ]
    },
    "passScorecard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "reviewerId",
        "sessionId",
        "reviewIndex",
        "scoredAt",
        "presentedLabel",
        "scorecardPath",
        "scorecardSha256",
        "reportedScore",
        "dimensionScores"
      ],
      "properties": {
        "order": { "enum": ["A/B", "B/A"] },
        "reviewerId": { "type": "string", "minLength": 8 },
        "sessionId": { "type": "string", "minLength": 8 },
        "reviewIndex": { "type": "integer", "minimum": 0, "maximum": 1 },
        "scoredAt": { "type": "string", "format": "date-time" },
        "presentedLabel": { "enum": ["A", "B"] },
        "scorecardPath": { "type": "string", "minLength": 3 },
        "scorecardSha256": { "$ref": "#/$defs/sha256" },
        "reportedScore": { "type": "number", "minimum": 0, "maximum": 100 },
        "dimensionScores": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "instructional-alignment",
            "accuracy-source-fidelity",
            "assessment-feedback",
            "teaching-learning-usability",
            "student-clarity-support",
            "inclusion-accessibility",
            "integrity-safety-rights",
            "professional-craft",
            "cross-artifact-coherence"
          ],
          "properties": {
            "instructional-alignment": { "type": "number", "minimum": 0, "maximum": 100 },
            "accuracy-source-fidelity": { "type": "number", "minimum": 0, "maximum": 100 },
            "assessment-feedback": { "type": "number", "minimum": 0, "maximum": 100 },
            "teaching-learning-usability": { "type": "number", "minimum": 0, "maximum": 100 },
            "student-clarity-support": { "type": "number", "minimum": 0, "maximum": 100 },
            "inclusion-accessibility": { "type": "number", "minimum": 0, "maximum": 100 },
            "integrity-safety-rights": { "type": "number", "minimum": 0, "maximum": 100 },
            "professional-craft": { "type": "number", "minimum": 0, "maximum": 100 },
            "cross-artifact-coherence": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        }
      }
    },
    "decisionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "artifactLabel", "artifactSha256", "dimensionId", "location", "observation"],
      "properties": {
        "kind": { "enum": ["defect", "advantage"] },
        "artifactLabel": { "enum": ["A", "B"] },
        "artifactSha256": { "$ref": "#/$defs/sha256" },
        "dimensionId": {
          "enum": [
            "instructional-alignment",
            "accuracy-source-fidelity",
            "assessment-feedback",
            "teaching-learning-usability",
            "student-clarity-support",
            "inclusion-accessibility",
            "integrity-safety-rights",
            "professional-craft",
            "cross-artifact-coherence"
          ]
        },
        "location": { "type": "string", "minLength": 3 },
        "observation": { "type": "string", "minLength": 20 }
      }
    },
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "split",
        "deliverableType",
        "trialIndex",
        "seed",
        "sourceSha256",
        "matchedInputSha256",
        "matchedSettingsSha256",
        "randomization",
        "outputs",
        "preferences"
      ],
      "properties": {
        "caseId": { "type": "string" },
        "split": { "enum": ["dev", "calibration", "heldout"] },
        "deliverableType": { "type": "string" },
        "trialIndex": { "type": "integer", "minimum": 1 },
        "seed": { "type": "string" },
        "sourceSha256": { "$ref": "#/$defs/sha256" },
        "matchedInputSha256": { "$ref": "#/$defs/sha256" },
        "matchedSettingsSha256": { "$ref": "#/$defs/sha256" },
        "randomization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["candidateLabel", "controlLabel", "seed", "method"],
          "properties": {
            "candidateLabel": { "enum": ["A", "B"] },
            "controlLabel": { "enum": ["A", "B"] },
            "seed": { "type": "string", "minLength": 4 },
            "method": { "type": "string", "minLength": 8 }
          }
        },
        "outputs": {
          "type": "object",
          "required": ["candidate", "control"],
          "properties": { "candidate": { "$ref": "#/$defs/output" }, "control": { "$ref": "#/$defs/output" } }
        },
        "preferences": { "type": "array", "items": { "$ref": "#/$defs/preference" } }
      }
    }
  }
}
