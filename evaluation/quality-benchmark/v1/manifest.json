    }
  ],
  "claimBoundary": "The corpus supports development, calibration, and matched comparisons. It does not by itself prove classroom effectiveness or instructor validation.",
  "singleModelJudgePolicy": {
    "templatePath": "evaluation/quality-benchmark/v1/comparison.model-judge.template.json",
    "templateSha256": "03e59f9fc61ade14c6f63fa2132b74b23038161bf030faf32acd604d9b6962c9",
    "promptPath": "evaluation/quality-benchmark/v1/single-model-judge-prompt-v1.md",
    "promptSha256": "d0f916c11f076aebf41a6fb9ee0c0ceb8c8e14966cf97acccbaae6be1b325a15",
    "claimBoundary": "A preregistered single model judge may support a bounded model-judged comparison only after exact provenance, two isolated scoring-first sessions, recomputable full-review scorecards, structured artifact-bound decision evidence, measured score order effects, and stable A/B plus B/A outcomes. It never becomes human, instructor, independent, classroom, or multi-judge evidence."
  },
  "splitPolicy": {
    "dev": "Open cases for scorer implementation, debugging, and failure discovery. Never use their results as held-out effect evidence.",
    "calibration": "Open cases for anchor training, rater calibration, model-judge calibration, and threshold selection. Freeze decisions before held-out access.",
    "heldout": "Public-governed evaluation cases. Contents are visible in this open repository, so contamination remains possible; the runner requires explicit unlock and records access. A private external-custodian replacement is recommended for confirmatory claims.",
    "minimumCasesPerReportedStratum": 2,
    "minimumTrialsPerCase": 3,
    "requiredQualifiedReviewersPerCase": 2,
    "minimumValidatedHeldoutCases": 4
  },
  "leakageControls": {
    "developmentMayRead": ["dev"],
    "calibrationMayRead": ["dev", "calibration"],
    "heldoutAccessRequiresFlag": "--unlock-heldout",
    "preRegistrationRequiredBeforeHeldout": true,
    "recordRequired": [
      "benchmarkVersion",
      "case hashes",
      "git commit and dirty state",
      "prompt hashes",
      "model revisions",
      "settings",
      "access time",
      "operator",
      "contamination declaration"
    ],
    "knownLimitation": "Repository-visible held-out inputs can be memorized or intentionally tuned against. Report that exposure and use externally sealed cases for high-stakes confirmatory comparison."
  },
