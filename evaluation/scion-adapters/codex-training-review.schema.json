{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edutool.dev/schemas/scion-codex-training-review-v2.json",
  "title": "Scion Codex training review batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocol",
    "benchmarkProtocol",
    "policyId",
    "sourcePacket",
    "order",
    "judge",
    "evidenceClass",
    "humanEvidence",
    "independentEvidence",
    "previousOutcomeAvailable",
    "contextResetAttestation",
    "attestation",
    "completedAt",
    "claimBoundary",
    "reviews"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "protocol": { "const": "scion-codex-training-review-v2" },
    "benchmarkProtocol": { "const": "honest-quality-benchmark-v1" },
    "policyId": { "const": "scion-codex-judge-policy-v1" },
    "sourcePacket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "packetId", "packetDigest", "organizerDigest"],
      "properties": {
        "protocol": { "const": "scion-blind-atom-packet-v4" },
        "packetId": { "type": "string", "minLength": 10 },
        "packetDigest": { "$ref": "#/$defs/sha256" },
        "organizerDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "order": { "enum": ["A/B", "B/A"] },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "revision", "runtime", "sessionId", "promptPath", "promptSha256"],
      "properties": {
        "model": { "const": "openai/codex" },
        "revision": { "type": "string", "minLength": 3 },
        "runtime": { "type": "string", "minLength": 3 },
        "sessionId": { "type": "string", "minLength": 3 },
        "promptPath": {
          "const": "evaluation/quality-benchmark/v1/single-model-training-atom-judge-prompt-v2.md"
        },
        "promptSha256": {
          "const": "0f062d551af9e2704892e5f1ebdf9b4c66a6d79de6ac1c9cf39b7cb4fa15ecd7"
        }
      }
    },
    "evidenceClass": { "const": "single-model-judge" },
    "humanEvidence": { "const": false },
    "independentEvidence": { "const": false },
    "previousOutcomeAvailable": { "const": false },
    "contextResetAttestation": { "const": true },
    "attestation": { "const": true },
    "completedAt": { "type": "string", "format": "date-time" },
    "claimBoundary": { "type": "string", "pattern": "single-model" },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/review" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factualCorrectness", "sourceFidelity", "teachability", "coherence", "taskQuality"],
      "properties": {
        "factualCorrectness": { "type": "integer", "minimum": 1, "maximum": 5 },
        "sourceFidelity": { "type": "integer", "minimum": 1, "maximum": 5 },
        "teachability": { "type": "integer", "minimum": 1, "maximum": 5 },
        "coherence": { "type": "integer", "minimum": 1, "maximum": 5 },
        "taskQuality": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    },
    "nullScores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factualCorrectness", "sourceFidelity", "teachability", "coherence", "taskQuality"],
      "properties": {
        "factualCorrectness": { "type": "null" },
        "sourceFidelity": { "type": "null" },
        "teachability": { "type": "null" },
        "coherence": { "type": "null" },
        "taskQuality": { "type": "null" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "anonymousSide", "artifactSha256", "artifact"],
      "properties": {
        "position": { "type": "integer", "minimum": 1, "maximum": 2 },
        "anonymousSide": { "enum": ["A", "B"] },
        "artifactSha256": { "$ref": "#/$defs/sha256" },
        "artifact": {}
      }
    },
    "scorecard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "anonymousSide", "artifactSha256", "evaluationStatus", "scores", "evidence", "defects"],
      "properties": {
        "position": { "type": "integer", "minimum": 1, "maximum": 2 },
        "anonymousSide": { "enum": ["A", "B"] },
        "artifactSha256": { "$ref": "#/$defs/sha256" },
        "evaluationStatus": { "enum": ["scored", "insufficient-evidence"] },
        "scores": {},
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 8 } },
        "defects": { "type": "array", "items": { "type": "string", "minLength": 10 } }
      },
      "allOf": [
        {
          "if": { "properties": { "evaluationStatus": { "const": "scored" } } },
          "then": { "properties": { "scores": { "$ref": "#/$defs/scores" } } }
        },
        {
          "if": { "properties": { "evaluationStatus": { "const": "insufficient-evidence" } } },
          "then": { "properties": { "scores": { "$ref": "#/$defs/nullScores" } } }
        }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pairId",
        "caseDigest",
        "domain",
        "courseGroupSha256",
        "sourceContextSha256",
        "sourceContext",
        "evidenceScope",
        "presentation",
        "scorecards",
        "preference"
      ],
      "properties": {
        "pairId": { "type": "string", "minLength": 3 },
        "caseDigest": { "$ref": "#/$defs/sha256" },
        "domain": { "type": "string", "minLength": 3 },
        "courseGroupSha256": { "$ref": "#/$defs/sha256" },
        "sourceContextSha256": { "$ref": "#/$defs/sha256" },
        "sourceContext": { "type": "object", "minProperties": 1 },
        "evidenceScope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unit", "excludedConstructs"],
          "properties": {
            "unit": { "const": "source-bound-training-atom" },
            "excludedConstructs": {
              "type": "array",
              "minItems": 7,
              "maxItems": 7,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "export-integrity",
                  "package-integrity",
                  "compiler-burden",
                  "full-course-coherence",
                  "device-runtime",
                  "speed",
                  "cost"
                ]
              }
            }
          }
        },
        "presentation": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/artifact" }
        },
        "scorecards": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/scorecard" }
        },
        "preference": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scoredBeforePreference", "decision", "winnerPosition", "rationale", "decisionDefects"],
          "properties": {
            "scoredBeforePreference": { "const": true },
            "decision": { "enum": ["winner", "tie", "insufficient-evidence"] },
            "winnerPosition": {
              "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 2 }, { "type": "null" }]
            },
            "rationale": { "type": "string", "minLength": 30 },
            "decisionDefects": {
              "type": "array",
              "items": { "type": "string", "minLength": 10 }
            }
          },
          "allOf": [
            {
              "if": { "properties": { "decision": { "const": "winner" } } },
              "then": { "properties": { "winnerPosition": { "type": "integer", "minimum": 1, "maximum": 2 } } }
            },
            {
              "if": { "properties": { "decision": { "enum": ["tie", "insufficient-evidence"] } } },
              "then": { "properties": { "winnerPosition": { "type": "null" } } }
            }
          ]
        }
      }
    }
  }
}
