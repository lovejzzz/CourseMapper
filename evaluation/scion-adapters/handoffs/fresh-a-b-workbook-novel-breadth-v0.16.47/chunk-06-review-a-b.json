          "artifact": {
            "q": "Which condition is necessary for a causal claim derived from a natural experiment to be credible?",
            "op": [
              "The policy change must affect both groups equally.",
              "The two groups must be comparable apart from the change.",
              "The effect can be attributed to the policy regardless of comparability.",
              "The external event must be the only factor influencing the outcome."
            ],
            "ai": 1,
            "ex": "The correct choice is that the two groups must be comparable apart from the change. A common misconception is believing that the effect can be attributed to the policy regardless of comparability, which ignores the requirement for comparability."
          }
        },
