          "anonymousSide": "B",
          "artifactSha256": "767e88721af0aa221e31e87daf826326b5d1507434450c33d4b5977adb887e82",
          "artifact": {
            "q": "Researchers observe two groups after a policy change and want to claim the policy caused the difference. What condition is required for that causal interpretation?",
            "op": [
              "The groups must be comparable apart from the change.",
              "The groups must be perfectly identical in every respect.",
              "Any two groups are enough if the sample is large.",
              "A causal claim is justified whenever the data are observational."
            ],
            "ai": 0,
            "ex": "Correct: the causal claim is credible only if the groups were comparable apart from the change. The common misconception is that large observational samples alone establish causation; size cannot replace comparability, because a confounding factor could still explain the difference."
          }
        }
