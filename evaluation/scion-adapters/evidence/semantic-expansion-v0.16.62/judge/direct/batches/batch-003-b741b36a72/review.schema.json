{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "protocol": { "type": "string", "const": "scion-lesson-kernel-blind-review-v1" },
    "order": { "type": "string", "enum": ["A/B", "B/A"] },
    "packetSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sessionId": { "type": "string", "minLength": 8 },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "runtime": { "type": "string", "minLength": 1 }
      },
      "required": ["model", "revision", "runtime"]
    },
    "completedAt": { "type": "string", "minLength": 10 },
    "attestations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "anonymousArtifactsOnly": { "type": "boolean", "const": true },
        "otherOrderUnavailable": { "type": "boolean", "const": true },
        "organizerMappingUnavailable": { "type": "boolean", "const": true }
      },
      "required": ["anonymousArtifactsOnly", "otherOrderUnavailable", "organizerMappingUnavailable"]
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "caseId": { "type": "string", "minLength": 1 },
          "pairId": { "type": "string", "minLength": 1 },
          "artifactSha256": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "A": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "B": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            },
            "required": ["A", "B"]
          },
          "scores": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "A": { "$ref": "#/$defs/artifactScores" },
              "B": { "$ref": "#/$defs/artifactScores" }
            },
            "required": ["A", "B"]
          },
          "criticalDefects": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "A": { "type": "array", "items": { "type": "string" } },
              "B": { "type": "array", "items": { "type": "string" } }
            },
            "required": ["A", "B"]
          },
          "decision": { "type": "string", "enum": ["A", "B", "tie", "insufficient-evidence"] },
          "rationale": { "type": "string", "minLength": 20 }
        },
        "required": ["caseId", "pairId", "artifactSha256", "scores", "criticalDefects", "decision", "rationale"]
      }
    }
  },
  "required": [
    "schemaVersion",
    "protocol",
    "order",
    "packetSha256",
    "sessionId",
    "judge",
    "completedAt",
    "attestations",
    "decisions"
  ],
  "$defs": {
    "rating": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 4 },
        "evidence": { "type": "string", "minLength": 12 }
      },
      "required": ["score", "evidence"]
    },
    "artifactScores": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceFidelity": { "$ref": "#/$defs/rating" },
        "knowledgePrecision": { "$ref": "#/$defs/rating" },
        "scenarioReadiness": { "$ref": "#/$defs/rating" },
        "assessmentCorrectness": { "$ref": "#/$defs/rating" },
        "choiceDiscriminability": { "$ref": "#/$defs/rating" },
        "feedbackInstructionality": { "$ref": "#/$defs/rating" },
        "internalCoherence": { "$ref": "#/$defs/rating" }
      },
      "required": [
        "sourceFidelity",
        "knowledgePrecision",
        "scenarioReadiness",
        "assessmentCorrectness",
        "choiceDiscriminability",
        "feedbackInstructionality",
        "internalCoherence"
      ]
    }
  }
}
