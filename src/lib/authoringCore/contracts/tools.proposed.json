            "maxLength": 120
          },
          "contractHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bundle": {
            "$ref": "urn:coursemapper:authoring:lesson-bundle:v1"
          }
        },
        "required": [
