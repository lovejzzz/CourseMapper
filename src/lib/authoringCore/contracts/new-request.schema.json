{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "brief": {
      "type": "string",
      "minLength": 1,
      "maxLength": 6000
    },
    "learnerProfile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2400
    },
    "language": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "lessonCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 52
    },
    "sessionMinutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 480
    },
    "requestedFeatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": ["lessonPlans", "assignments", "rubrics"]
      }
    },
    "mode": {
      "const": "new-course"
    },
    "sourcePolicy": {
      "enum": ["no-uploaded-sources", "explicit-shared-snapshots"]
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1600
      },
      "minItems": 0,
      "maxItems": 20
    }
  },
  "required": [
    "title",
    "brief",
    "learnerProfile",
    "language",
    "lessonCount",
    "sessionMinutes",
    "requestedFeatures",
    "mode",
    "sourcePolicy",
    "uncertainties"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:coursemapper:authoring:new-request:v2",
  "title": "Proposed new private course request - does not authorize existing project access"
}
