{
  "name": "course-mapper",
  "version": "0.16.8",
  "type": "module",
  "description": "AI-powered course syllabus to course map generator",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite preview --host 0.0.0.0",
    "preview": "vite preview",
    "test": "vitest run --exclude='tests/**/*.spec.js' --exclude='scripts/__tests__/goldSampleQualityAudit.test.js' --exclude='scripts/__tests__/expertReviewQualityAudit.test.js' --exclude='scripts/__tests__/externalQualityProofPacket.test.js'",
    "test:unit": "vitest run --exclude='tests/**/*.spec.js' --exclude='scripts/__tests__/goldSampleQualityAudit.test.js' --exclude='scripts/__tests__/expertReviewQualityAudit.test.js' --exclude='scripts/__tests__/externalQualityProofPacket.test.js'",
    "test:blueprint:quality:fast": "BLUEPRINT_QUALITY_MATRIX=core vitest run tests/blueprint-quality-matrix.test.js",
    "test:blueprint:quality": "vitest run tests/blueprint-quality-matrix.test.js",
    "test:blueprint:quality:release": "npm run test:blueprint:quality && npm run audit:blueprint:quality-sample",
    "test:rules": "firebase emulators:exec --project coursemapper-rules-test --only firestore \"vitest run src/lib/__tests__/firestoreRules.emulator.test.js\"",
    "test:e2e": "playwright test",
    "test:v0858:agent": "vitest run tests/agent-v0858-red-team.test.jsx",
    "test:offline": "vitest run src/",
    "trellis": "npx vite-node trellis/cli.mjs --",
    "trellis:test": "vitest run trellis",
    "lint": "eslint . --quiet",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "bundle:check": "node scripts/checkBundleBudgets.mjs",
    "genome:build": "node scripts/foundry/buildShards.mjs",
    "knowledge:audit": "npx vite-node scripts/knowledgeAudit.mjs",
    "audit:constitution": "node scripts/constitutionAudit.mjs",
    "audit:release-history": "node scripts/auditReleaseHistory.mjs",
    "audit:pipeline": "node scripts/hybridPipelineAudit.mjs",
    "audit:gold": "node scripts/goldSampleQualityAudit.mjs",
    "audit:gold:smoke": "node scripts/goldSampleQualityAudit.mjs --sample gold-research-methods-short-5,gold-ai-course-design-8,gold-community-health-semester-14",
    "audit:gold:ci": "node scripts/goldSampleQualityAudit.mjs --sample gold-research-methods-short-5,gold-research-methods-8,gold-research-methods-semester-14,gold-ai-course-design-8,gold-ai-course-design-semester-14,gold-community-health-semester-14,gold-multi-section-seminar-8,gold-business-strategy-case-8,gold-teacher-preparation-8,gold-sparse-assessment-resilience-8",
    "audit:contract": "node scripts/contractQualityAudit.mjs --profile full",
    "audit:contract:pr": "node scripts/contractQualityAudit.mjs --profile pr",
    "audit:contract:full": "node scripts/contractQualityAudit.mjs --profile full",
    "audit:benchmark": "node scripts/independentBenchmarkAudit.mjs --mode advisory",
    "audit:benchmark:strict": "node scripts/independentBenchmarkAudit.mjs --mode strict",
    "audit:canary": "node scripts/productionCanaryAudit.mjs --mode advisory",
    "audit:canary:strict": "node scripts/productionCanaryAudit.mjs --mode strict",
    "retain:canary": "node scripts/retainProductionCanaryArtifacts.mjs",
    "audit:evaluation:pr": "node scripts/evaluationSystemAudit.mjs --profile pr",
    "audit:evaluation:main": "node scripts/evaluationSystemAudit.mjs --profile main",
    "audit:evaluation:release": "node scripts/evaluationSystemAudit.mjs --profile release",
    "audit:quiz:contrast": "node scripts/quizContrastAudit.mjs",
    "audit:scion:matrix": "node scripts/scionContrastMatrixAudit.mjs",
    "audit:scion:applied-repair": "node scripts/scionAppliedRepairProbe.mjs",
    "audit:scion:corpus": "node scripts/scionPreferenceCorpusAudit.mjs",
    "audit:scion:review-candidates": "node scripts/scionMatchedReviewCandidates.mjs",
    "audit:scion:review-packet": "node scripts/scionMatchedReviewCandidates.mjs && node scripts/scionBlindReviewPacket.mjs",
    "audit:scion:reviews": "node scripts/scionBlindReviewPacket.mjs --ingest",
    "audit:scion:factual-canaries": "node scripts/scionFactualCanaryAudit.mjs",
    "audit:scion:model-bakeoff": "node scripts/scionModelBakeoff.mjs",
    "audit:scion:model-bakeoff:list": "node scripts/scionModelBakeoff.mjs --list",
    "audit:scion:compiler-burden": "node scripts/scionCompilerBurdenAudit.mjs",
    "build:scion:adapter-dataset": "node scripts/scionAdapterDataset.mjs",
    "package:scion:adapter": "node scripts/scionAdapterPackage.mjs",
    "package:scion:adapter:browser": "node scripts/scionAdapterBrowserPackage.mjs",
    "audit:scion:adapter": "node scripts/scionAdapterPackage.mjs --verify",
    "audit:scion:adapter:promotion": "node scripts/scionAdapterPromotionAudit.mjs",
    "capture:scion:adapter:pairs": "node scripts/scionAdapterPairedEvidence.mjs",
    "audit:scion:browser-base": "node scripts/scionBrowserBaseAudit.mjs",
    "audit:scion:browser-lora": "node scripts/scionBrowserLoraRuntimeAudit.mjs",
    "audit:scion:browser-adapter-smoke": "node scripts/scionBrowserAdapterSmokeAudit.mjs",
    "train:scion:adapter": "zsh trellis/tendril/distill/run_orpo_g4.sh",
    "audit:deep-quality": "node scripts/deepProofQualityGate.mjs",
    "audit:self": "node scripts/internalSelfImprovementAudit.mjs",
    "audit:self:rounds": "node scripts/internalSelfImprovementAudit.mjs --rounds 5",
    "audit:self:100": "node scripts/internalSelfImprovementAudit.mjs --rounds 100",
    "audit:self:500": "node scripts/internalSelfImprovementAudit.mjs --rounds 500",
    "audit:professor-adoption:smoke": "node scripts/professorAdoptionAudit.mjs --profile smoke",
    "audit:professor-adoption": "node scripts/professorAdoptionAudit.mjs --profile full",
    "audit:professor-adoption:100": "node scripts/professorAdoptionAudit.mjs --profile full --rounds 100",
    "audit:professor-adoption:sources": "node scripts/professorAdoptionSourceAudit.mjs --profile full",
    "audit:professor-adoption:sources:smoke": "node scripts/professorAdoptionSourceAudit.mjs --profile smoke",
    "audit:adoption-verdict": "node scripts/adoptionVerdictAudit.mjs",
    "audit:blueprint:quality-sample": "node scripts/blueprintQualitySampleAudit.mjs",
    "audit:v085:sweep": "node scripts/v085QualitySweep.mjs",
    "audit:v0855:sweep": "node scripts/v085QualitySweep.mjs --release-label v0.8.55 --count 34 --output-dir verification-output/v0.8.55-quality-sweep --no-progress",
    "audit:v0856:sweep": "node scripts/v085QualitySweep.mjs --release-label v0.8.56 --count 34 --output-dir verification-output/v0.8.56-quality-sweep --no-progress",
    "audit:v0857:sweep": "node scripts/v085QualitySweep.mjs --release-label v0.8.57 --count 34 --output-dir verification-output/v0.8.57-quality-sweep --no-progress",
    "audit:v0858:red-team": "node scripts/v0858RedTeamAudit.mjs",
    "audit:v0858:sweep": "node scripts/v085QualitySweep.mjs --release-label v0.8.58 --count 34 --output-dir verification-output/v0.8.58-export-torture --no-progress",
    "local-model": "node scripts/crucible/e2bOpenAIShim.mjs",
    "crucible": "node scripts/crucible.mjs --courses all",
    "crucible:smoke": "node scripts/crucible.mjs --courses smoke",
    "crucible:dry": "node scripts/crucible.mjs --dry-run",
    "crucible:history": "node scripts/crucible.mjs --history",
    "crucible:calibrate": "node scripts/crucible.mjs --calibrate",
    "quality:browser:smoke": "node scripts/liveBrowserQualityLoop.mjs --profile smoke --courses 1",
    "quality:browser:nightly": "node scripts/liveBrowserQualityLoop.mjs --profile nightly --courses 3",
    "quality:browser:weekly": "node scripts/liveBrowserQualityLoop.mjs --profile weekly --courses 10",
    "quality:agent:browser:smoke": "node scripts/realBrowserAgentQualityLoop.mjs --profile smoke --tasks 10",
    "quality:agent:browser:full": "node scripts/realBrowserAgentQualityLoop.mjs --profile full --tasks 25",
    "audit:expert": "node scripts/expertReviewQualityAudit.mjs",
    "audit:expert:external": "node scripts/expertReviewQualityAudit.mjs --require-external-proof",
    "audit:expert:preflight": "node scripts/expertReviewQualityAudit.mjs --require-external-proof --preflight",
    "audit:expert:packet": "node scripts/externalQualityProofPacket.mjs",
    "audit:deliverables": "vitest run tests/deliverable-quality-audit.test.js",
    "audit:agent:openai": "vitest run tests/agent-openai.test.js",
    "audit:agent": "vitest run tests/agent-anthropic.test.js tests/agent-multi-turn.test.js tests/agent-quality-probe.test.js tests/agent-content-quality.test.js tests/agent-prose-regression.test.js tests/cache-smoke.test.js tests/agent-skill-nudge.test.js tests/partial-failure-recovery.test.js",
    "curriculumos:proof": "npx vite-node scripts/curriculumosHeadlessProof.mjs",
    "prof": "npx vite-node scripts/prof.mjs",
    "prof:gauntlet": "npx vite-node scripts/prof/gauntlet.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.0",
    "@uiw/react-codemirror": "^4.25.9",
    "docx": "^9.5.1",
    "dompurify": "^3.4.1",
    "file-saver": "^2.0.5",
    "firebase": "^12.12.1",
    "focus-trap-react": "^12.0.0",
    "jsonrepair": "^3.15.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^4.0.379",
    "pptxgenjs": "^4.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "text-readability": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@huggingface/transformers": "^4.2.0",
    "@playwright/test": "^1.58.2",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.17",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-tools": "^15.16.0",
    "globals": "^17.6.0",
    "happy-dom": "^20.9.0",
    "postcss": "^8.4.33",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.1",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
