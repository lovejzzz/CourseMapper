{
  "name": "course-mapper",
  "version": "0.5.0",
  "type": "module",
  "description": "AI-powered course syllabus to course map generator",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite preview --host 0.0.0.0",
    "preview": "vite preview",
    "test": "vitest run --exclude='tests/**/*.spec.js'",
    "test:unit": "vitest run --exclude='tests/**/*.spec.js'",
    "test:rules": "firebase emulators:exec --project coursemapper-rules-test --only firestore \"vitest run src/lib/__tests__/firestoreRules.emulator.test.js\"",
    "test:e2e": "playwright test",
    "test:offline": "vitest run src/",
    "lint": "eslint . --quiet",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "bundle:check": "node scripts/checkBundleBudgets.mjs",
    "quality:deliverables": "node scripts/internalDeliverableQualityLoop.mjs",
    "quality:deliverables:dry": "node scripts/internalDeliverableQualityLoop.mjs --dry-run",
    "audit:deliverables": "vitest run tests/deliverable-quality-audit.test.js",
    "audit:agent:openai": "vitest run tests/agent-openai.test.js",
    "audit:agent": "vitest run tests/agent-anthropic.test.js tests/agent-multi-turn.test.js tests/agent-quality-probe.test.js tests/agent-content-quality.test.js tests/agent-prose-regression.test.js tests/cache-smoke.test.js tests/agent-skill-nudge.test.js tests/partial-failure-recovery.test.js"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.0",
    "@uiw/react-codemirror": "^4.25.9",
    "docx": "^9.5.1",
    "dompurify": "^3.4.1",
    "file-saver": "^2.0.5",
    "firebase": "^12.12.1",
    "focus-trap-react": "^12.0.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^4.0.379",
    "pptxgenjs": "^4.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "text-readability": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.58.2",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.17",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-tools": "^15.16.0",
    "globals": "^17.6.0",
    "happy-dom": "^20.9.0",
    "postcss": "^8.4.33",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.1",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
