{
  "name": "course-mapper",
  "version": "0.19.0-rc.1",
  "type": "module",
  "description": "Editable, linked educational materials with source-grounded generation and classroom exports",
  "scripts": {
    "dev": "vite --config vite.studio.config.ts",
    "prebuild": "node scripts/cleanDist.mjs",
    "build": "vite build --config vite.studio.config.ts",
    "preview": "vite preview --config vite.studio.config.ts",
    "start": "npm run preview",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run bundle:check",
    "typecheck": "npm run studio:typecheck && npm run scion:typecheck",
    "studio:typecheck": "tsc -p tsconfig.studio.json",
    "scion:typecheck": "tsc -p tsconfig.scion.json",
    "test": "vitest run --config vitest.studio.config.ts",
    "test:unit": "npm test",
    "studio:test": "npm test",
    "test:e2e": "playwright test --config playwright.studio.config.ts",
    "lint": "eslint src server scripts/studio tests/studio *.ts --quiet",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "bundle:check": "node scripts/studio/check-build.mjs",
    "studio:generate": "node scripts/studio/generate.mjs",
    "scion:serve": "node server/scion/gateway.ts",
    "scion:deploy": "wrangler deploy --config server/scion/wrangler.jsonc"
  },
  "dependencies": {
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@wllama/wllama": "3.6.1",
    "docx": "^9.5.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^4.0.379",
    "pdfmake": "0.2.23",
    "pptxgenjs": "^4.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260905.1",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.58.2",
    "@types/pdfmake": "0.2.12",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.5",
    "wrangler": "4.129.0"
  }
}
