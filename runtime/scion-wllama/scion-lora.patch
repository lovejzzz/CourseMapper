+  private normalizeLoraStatus(result: {
+    active: boolean;
+    path: string;
+    scale: number;
+    metadata_key: string[];
+    metadata_val: string[];
+  }): LoraAdapterStatus {
+    const metadata: Record<string, string> = {};
+    for (let index = 0; index < result.metadata_key.length; index++) {
+      metadata[result.metadata_key[index]] = result.metadata_val[index];
+    }
+    return {
+      active: result.active,
+      path: result.path,
+      scale: result.scale,
+      metadata,
+    };
+  }
