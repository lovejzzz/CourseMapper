+kv_dump dump_adapter_metadata(const llama_adapter_lora *adapter)
+{
+  kv_dump output;
+  int count = llama_adapter_meta_count(adapter);
+  std::vector<char> buf(1024);
+  for (int i = 0; i < count; i++)
+  {
+    int res = llama_adapter_meta_val_str_by_index(adapter, i, buf.data(), buf.size());
+    if (res < 0)
+      continue;
+    if ((size_t)res >= buf.size())
+    {
+      buf.resize(res + 1);
+      res = llama_adapter_meta_val_str_by_index(adapter, i, buf.data(), buf.size());
+    }
+    std::string val(buf.data(), res);
+    res = llama_adapter_meta_key_by_index(adapter, i, buf.data(), buf.size());
+    if (res < 0)
+      continue;
+    if ((size_t)res >= buf.size())
+    {
+      buf.resize(res + 1);
+      res = llama_adapter_meta_key_by_index(adapter, i, buf.data(), buf.size());
+    }
+    output.keys.emplace_back(buf.data(), res);
+    output.vals.push_back(std::move(val));
+  }
+  return output;
+}
+
+void clear_generation_state(app_t &app)
+{
+  auto *mem = llama_get_memory(app.ctx);
+  llama_memory_clear(mem, true);
+  app.tokens.clear();
+}
+
+glue_msg_lora_load_res action_lora_load(app_t &app, const char *req_raw)
+{
+  PARSE_REQ(glue_msg_lora_load_req);
+  if (app.model == nullptr || app.ctx == nullptr)
+    throw app_exception("Load the base model before loading a LoRA adapter");
+  if (req.path.value.empty())
+    throw app_exception("LoRA adapter path is empty");
+
+  if (app.lora != nullptr)
+  {
+    if (llama_set_adapters_lora(app.ctx, nullptr, 0, nullptr) != 0)
+      throw app_exception("Unable to clear the previous LoRA adapter");
+    llama_adapter_lora_free(app.lora);
+    app.lora = nullptr;
+  }
+
+  llama_adapter_lora *candidate = llama_adapter_lora_init(app.model, req.path.value.c_str());
+  if (candidate == nullptr)
+    throw app_exception("Unable to load LoRA adapter");
+  llama_adapter_lora *adapters[] = {candidate};
+  float scales[] = {req.scale.value};
+  if (llama_set_adapters_lora(app.ctx, adapters, 1, scales) != 0)
+  {
+    llama_adapter_lora_free(candidate);
+    throw app_exception("Unable to apply LoRA adapter to the active context");
+  }
+
+  app.lora = candidate;
+  app.lora_path = req.path.value;
+  app.lora_scale = req.scale.value;
+  clear_generation_state(app);
+  kv_dump metadata = dump_adapter_metadata(app.lora);
+
+  glue_msg_lora_load_res res;
+  res.success.value = true;
+  res.path.value = app.lora_path;
+  res.scale.value = app.lora_scale;
+  res.metadata_key.arr = std::move(metadata.keys);
+  res.metadata_val.arr = std::move(metadata.vals);
+  return res;
+}
+
+glue_msg_lora_clear_res action_lora_clear(app_t &app, const char *req_raw)
+{
+  PARSE_REQ(glue_msg_lora_clear_req);
+  if (app.ctx == nullptr)
+    throw app_exception("Base model is not loaded");
+  if (llama_set_adapters_lora(app.ctx, nullptr, 0, nullptr) != 0)
+    throw app_exception("Unable to clear LoRA adapter");
+  if (app.lora != nullptr)
+  {
+    llama_adapter_lora_free(app.lora);
+    app.lora = nullptr;
+  }
+  app.lora_path.clear();
+  app.lora_scale = 0.0f;
+  clear_generation_state(app);
+
+  glue_msg_lora_clear_res res;
+  res.success.value = true;
+  return res;
+}
+
+glue_msg_lora_status_res action_lora_status(app_t &app, const char *req_raw)
+{
+  PARSE_REQ(glue_msg_lora_status_req);
+  glue_msg_lora_status_res res;
+  res.success.value = true;
+  res.active.value = app.lora != nullptr;
+  res.path.value = app.lora_path;
+  res.scale.value = app.lora_scale;
+  if (app.lora != nullptr)
+  {
+    kv_dump metadata = dump_adapter_metadata(app.lora);
+    res.metadata_key.arr = std::move(metadata.keys);
+    res.metadata_val.arr = std::move(metadata.vals);
+  }
+  return res;
+}
