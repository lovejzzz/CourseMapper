+import { describe, it, expect } from 'vitest';
+import { sourceRegions, resolveSourceRegionQuote } from '../scionSourceRegions.js';
+const inputs = [
+  { id: 'cups', text: '有24只杯子；一只杯子是实验单位。\n每只杯子只分配一次。' },
+  { id: 'other', text: '杯子。' },
+];
+
+describe('revision-bound source region addresses', () => {
+  it('preserves all bytes and original offsets including CRLF, emoji and decimals', () => {
+    const text = '🧪 Use 3.5 mL.\r\nThen measure; record. 尾句';
+    const [source] = sourceRegions([{ id: 'one', text }]);
+    expect(source.regions.map((region) => region.text).join('')).toBe(text);
+    for (const region of source.regions) expect(text.slice(region.start, region.end)).toBe(region.text);
+    expect(source.regions[0].text).toBe('🧪 Use 3.5 mL.');
+  });
+  it('resolves an explicit sentence anchor to the correct global occurrence', () => {
+    expect(resolveSourceRegionQuote(inputs, 'r1', { anchor: 'r1:s2', quote: '杯子' })).toEqual({
+      quote: '杯子',
+      occurrence: 1,
+    });
+  });
+  it('allows complete measurement quotes continuing into a later region', () => {
+    expect(
+      resolveSourceRegionQuote(inputs, 'r1', { anchor: 'r1:s2', quote: '一只杯子是实验单位。\n每只杯子' }).occurrence,
+    ).toBe(0);
+  });
+  it('rejects cross-record and missing anchors without guessing another occurrence', () => {
+    for (const anchor of ['r2:s1', 'r1:s99', undefined])
+      expect(resolveSourceRegionQuote(inputs, 'r1', { anchor, quote: '杯子' }).occurrence).toBe(-1);
+  });
+  it('rejects a quote that exists elsewhere but does not start in the declared region', () => {
+    expect(resolveSourceRegionQuote(inputs, 'r1', { anchor: 'r1:s1', quote: '一只杯子' }).occurrence).toBe(-1);
+  });
+  it('requires an explicit local match when the same phrase repeats within a region', () => {
+    const repeated = [{ id: 'one', text: 'cup and cup. cup' }];
+    expect(resolveSourceRegionQuote(repeated, 'r1', { anchor: 'r1:s1', quote: 'cup' }).occurrence).toBe(-1);
+    expect(resolveSourceRegionQuote(repeated, 'r1', { anchor: 'r1:s1', quote: 'cup', match: 2 }).occurrence).toBe(1);
+    expect(resolveSourceRegionQuote(repeated, 'r1', { anchor: 'r1:s2', quote: 'cup' }).occurrence).toBe(2);
+  });
+  it.each([0, -1, 2, 1.5, '1', null])('does not ignore explicit invalid local match %s on a unique quote', (match) => {
+    expect(resolveSourceRegionQuote(inputs, 'r1', { anchor: 'r1:s2', quote: '一只杯子', match }).occurrence).toBe(-1);
+  });
+});
