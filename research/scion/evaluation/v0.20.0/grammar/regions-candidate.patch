@@ -0,0 +1,39 @@
+import { quoteOccurrences } from './teachingTaskReview.js';
+
+export const SCION_SOURCE_REGION_PROTOCOL = 'record-regions-v1';
+
+/** Addresses are stable within an immutable source revision, not across edits.
+ * Split without rewriting any character, so offsets always refer to original text.
+ * A quote may continue past a region; only its starting position is anchored. */
+export function sourceRegions(inputs) {
+  return inputs.map((input, sourceIndex) => {
+    const id = `r${sourceIndex + 1}`;
+    const regions = [];
+    let start = 0;
+    const append = (end) => {
+      if (end <= start) return;
+      regions.push({ id: `${id}:s${regions.length + 1}`, start, end, text: input.text.slice(start, end) });
+      start = end;
+    };
+    for (const match of input.text.matchAll(/[。！？!?；;]+|\.(?=\s|$)|\r?\n/g)) append(match.index + match[0].length);
+    append(input.text.length);
+    return { id, inputId: input.id, text: input.text, regions };
+  });
+}
+
+export function resolveSourceRegionQuote(inputs, source, phrase) {
+  const invalid = (issue) => ({ quote: phrase?.quote, occurrence: -1, issue });
+  const owner = sourceRegions(inputs).find((entry) => entry.id === source);
+  if (!owner) return invalid('Choose an existing source record.');
+  const region = owner.regions.find((entry) => entry.id === phrase?.anchor);
+  if (!region) return invalid('The quote anchor does not belong to its source record.');
+  if (typeof phrase?.quote !== 'string' || !phrase.quote.length) return invalid('Supply a nonempty exact quote.');
+  const allPositions = quoteOccurrences(owner.text, phrase.quote);
+  const candidates = allPositions.filter((position) => position >= region.start && position < region.end);
+  const match = Object.hasOwn(phrase, 'match') ? phrase.match : candidates.length === 1 ? 1 : null;
+  if (!Number.isSafeInteger(match) || match < 1 || match > candidates.length)
+    return invalid(
+      `The anchored quote has ${candidates.length} matches; select a valid one-based match inside that region.`,
+    );
+  return { quote: phrase.quote, occurrence: allPositions.indexOf(candidates[match - 1]) };
+}
