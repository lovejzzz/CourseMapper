new file mode 100644
index 00000000..7eb18c55
--- /dev/null
+++ b/src/lib/__tests__/scionTeachingFocus.test.js
@@ -0,0 +1,82 @@
+import { describe, expect, it, vi } from 'vitest';
+import { suggestTeachingFocus, TEACHING_FOCUS_GRAMMAR } from '../scionTeachingFocus.js';
+const request = { objective: 'Compare event and recording dates.', inputs: [{ id: 'a', text: 'Record text' }] };
+const api = (complete = async () => '{"operation":"record-relative-day"}') => ({
+  loadScionBrowserWllama: vi.fn(async () => {}),
+  getScionBrowserWllamaStatus: () => ({ runtime: { grammar: 'gbnf-state-v1' } }),
+  completeScionBrowserWllama: vi.fn(complete),
+});
+describe('local task-focus suggestions', () => {
+  it('makes only one bounded constrained call and keeps the exact original inputs in its receipt', async () => {
+    const runtime = api();
+    const input = { ...request, referenceAnswer: 'must not reach model' };
+    const result = await suggestTeachingFocus(input, { runtimeLoader: async () => runtime });
+    expect(result.status).toBe('review');
+    expect(result.operation).toBe('record-relative-day');
+    expect(result.receipt.modelCalls).toBe(1);
+    expect(runtime.completeScionBrowserWllama).toHaveBeenCalledOnce();
+    const [messages, options] = runtime.completeScionBrowserWllama.mock.calls[0];
+    expect(JSON.parse(messages[1].content)).toEqual(request);
+    expect(options).toMatchObject({ maxNewTokens: 64, grammar: TEACHING_FOCUS_GRAMMAR, thinking: false });
+    expect(result.approved).toBeUndefined();
+  });
+  it('returns an unsupported result without choosing a default operation or retrying', async () => {
+    const runtime = api(async () => '{"operation":null}');
+    const result = await suggestTeachingFocus(request, { runtimeLoader: async () => runtime });
+    expect(result.status).toBe('unsupported');
+    expect(result.operation).toBeUndefined();
+    expect(runtime.completeScionBrowserWllama).toHaveBeenCalledOnce();
+  });
+  it('rejects malformed, unauthorized and truncated output while preserving raw evidence', async () => {
+    for (const raw of [
+      '{}',
+      '{"operation":"invented"}',
+      '{"operation":"record-relative-day","approved":true}',
+      'not json',
+    ]) {
+      const result = await suggestTeachingFocus(request, { runtimeLoader: async () => api(async () => raw) });
+      expect(result.status).toBe('unavailable');
+      expect(result.receipt.raw).toBe(raw);
+    }
+    const result = await suggestTeachingFocus(request, {
+      runtimeLoader: async () =>
+        api(async (_messages, options) => {
+          options.onCompletion({ finishReason: 'length' });
+          return '{"operation":"record-relative-day"}';
+        }),
+    });
+    expect(result.status).toBe('unavailable');
+  });
+  it('rejects invalid inputs and unsupported runtimes before inference', async () => {
+    const loader = vi.fn();
+    for (const input of [
+      {},
+      { ...request, inputs: [] },
+      { ...request, inputs: [request.inputs[0], request.inputs[0]] },
+      { ...request, objective: 'x'.repeat(6001) },
+    ])
+      expect((await suggestTeachingFocus(input, { runtimeLoader: loader })).modelCalls).toBe(0);
+    expect(loader).not.toHaveBeenCalled();
+    const runtime = api();
+    runtime.getScionBrowserWllamaStatus = () => ({ runtime: {} });
+    expect((await suggestTeachingFocus(request, { runtimeLoader: async () => runtime })).status).toBe('unavailable');
+    expect(runtime.completeScionBrowserWllama).not.toHaveBeenCalled();
+  });
+  it('preserves the pre-load snapshot and discards a cancelled completion', async () => {
+    const input = structuredClone(request);
+    const controller = new AbortController();
+    const runtime = api(async () => {
+      controller.abort();
+      return '{"operation":"record-relative-day"}';
+    });
+    const result = await suggestTeachingFocus(input, {
+      signal: controller.signal,
+      runtimeLoader: async () => {
+        input.inputs[0].text = 'Changed after request';
+        return runtime;
+      },
+    });
+    expect(result.status).toBe('cancelled');
+    expect(JSON.parse(result.receipt.messages[1].content)).toEqual(request);
+  });
+});
