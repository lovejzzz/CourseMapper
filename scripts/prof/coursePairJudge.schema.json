{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["winner", "confidence", "scores", "strengths", "weaknesses", "decisiveReasons"],
  "properties": {
    "winner": { "type": "string", "enum": ["A", "B", "tie"] },
    "confidence": { "type": "integer", "minimum": 0, "maximum": 100 },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A", "B"],
      "properties": {
        "A": { "$ref": "#/$defs/candidateScore" },
        "B": { "$ref": "#/$defs/candidateScore" }
      }
    },
    "strengths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A", "B"],
      "properties": {
        "A": { "type": "array", "items": { "type": "string" }, "maxItems": 5 },
        "B": { "type": "array", "items": { "type": "string" }, "maxItems": 5 }
      }
    },
    "weaknesses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A", "B"],
      "properties": {
        "A": { "type": "array", "items": { "type": "string" }, "maxItems": 5 },
        "B": { "type": "array", "items": { "type": "string" }, "maxItems": 5 }
      }
    },
    "decisiveReasons": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 5 }
  },
  "$defs": {
    "candidateScore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pedagogicalCoherence",
        "specificity",
        "learnerUsability",
        "assessmentAlignment",
        "editorialQuality",
        "overall"
      ],
      "properties": {
        "pedagogicalCoherence": { "type": "integer", "minimum": 0, "maximum": 100 },
        "specificity": { "type": "integer", "minimum": 0, "maximum": 100 },
        "learnerUsability": { "type": "integer", "minimum": 0, "maximum": 100 },
        "assessmentAlignment": { "type": "integer", "minimum": 0, "maximum": 100 },
        "editorialQuality": { "type": "integer", "minimum": 0, "maximum": 100 },
        "overall": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    }
  }
}
